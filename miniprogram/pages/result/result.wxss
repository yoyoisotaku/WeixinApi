.container {
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.card {
  width: 100%;
  background: rgba(30, 41, 59, 0.96);
  border-radius: 24rpx;
  padding: 36rpx;
  box-sizing: border-box;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.score {
  font-size: 108rpx;
  line-height: 1;
  margin-top: 26rpx;
  font-weight: 700;
  color: #22d3ee;
}

.score-label {
  color: #94a3b8;
  margin-top: 10rpx;
}

.meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 34rpx;
}

.meta-item {
  flex: 1;
  background: rgba(15, 23, 42, 0.8);
  border-radius: 16rpx;
  padding: 22rpx;
}

.meta-value {
  font-size: 42rpx;
  font-weight: 700;
}

.meta-label {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.btn-secondary {
  margin-top: 18rpx;
  border-radius: 999px;
  color: #e2e8f0;
  background: #334155;
}
